# dirsift QRadar AQL searches
# dirsift run golden-run | author cyb3rp03t | TLP:AMBER
# target hxxp://panel-gate[.]xyz/files/ | scan started 2026-10-01T09:00:00.000Z
# Found in an open directory, not a verdict: hunt with it, decide yourself.
# assumes QRadar events and flows (destinationip) and the event payload (UTF8(payload) ILIKE)
# assumes a 7 day window; each search is one line, paste one at a time
# live values, not defanged: import it, do not open it in a browser or paste it in a chat.

# 1. events to addresses found in the directory
SELECT * FROM events WHERE destinationip IN ('198.51.100.23', '203.0.113.9', '2001:db8::7') LAST 7 DAYS

# 2. flows to addresses found in the directory
SELECT * FROM flows WHERE destinationip IN ('198.51.100.23', '203.0.113.9', '2001:db8::7') LAST 7 DAYS

# 3. event payloads that name domains found in the directory
SELECT * FROM events WHERE UTF8(payload) ILIKE '%c2.evil-update.top%' OR UTF8(payload) ILIKE '%cdn.panel-gate.xyz%' OR UTF8(payload) ILIKE '%panel-gate.xyz%' LAST 7 DAYS

# 4. event payloads that carry URLs found in the directory
SELECT * FROM events WHERE UTF8(payload) ILIKE '%http://c2.evil-update.top/gate.php?id=1&k=*%' OR UTF8(payload) ILIKE '%http://panel-gate.xyz/files/%' OR UTF8(payload) ILIKE '%https://raw.githubusercontent.com/someone/tools/main/x.ps1%' LAST 7 DAYS

# 5. event payloads that carry hashes of files read whole in the directory
SELECT * FROM events WHERE UTF8(payload) ILIKE '%9f2c1b7d3e4a5f60718293a4b5c6d7e8f90a1b2c3d4e5f60718293a4b5c6d7e8%' OR UTF8(payload) ILIKE '%0a1b2c3d4e5f60718293a4b5c6d7e8f9%' LAST 7 DAYS
