// dirsift KQL hunting queries
// dirsift run golden-run | author cyb3rp03t | TLP:AMBER
// target hxxp://panel-gate[.]xyz/files/ | scan started 2026-10-01T09:00:00.000Z
// Found in an open directory, not a verdict: hunt with it, decide yourself.
// assumes Defender XDR advanced hunting tables (DeviceNetworkEvents, DeviceFileEvents, DeviceProcessEvents, EmailUrlInfo) and Sentinel tables (CommonSecurityLog, DnsEvents)
// assumes a 30 day window (Defender advanced hunting keeps 30 days)
// live values, not defanged: import it, do not open it in a browser or paste it in a chat.

// Defender XDR: devices that connected to addresses or hosts found in the directory
let dirsift_ip = dynamic(["198.51.100.23", "203.0.113.9", "2001:db8::7"]);
let dirsift_domain = dynamic(["c2.evil-update.top", "cdn.panel-gate.xyz", "panel-gate.xyz"]);
DeviceNetworkEvents
| where Timestamp > ago(30d)
| where RemoteIP in (dirsift_ip) or RemoteUrl has_any (dirsift_domain)
| project Timestamp, DeviceName, InitiatingProcessFileName, RemoteIP, RemotePort, RemoteUrl, ActionType

// Defender XDR: DeviceFileEvents for files read whole in the directory
let dirsift_sha256 = dynamic(["9f2c1b7d3e4a5f60718293a4b5c6d7e8f90a1b2c3d4e5f60718293a4b5c6d7e8"]);
let dirsift_md5 = dynamic(["0a1b2c3d4e5f60718293a4b5c6d7e8f9"]);
DeviceFileEvents
| where Timestamp > ago(30d)
| where SHA256 in~ (dirsift_sha256) or MD5 in~ (dirsift_md5)
| project Timestamp, DeviceName, ActionType, FolderPath, FileName, SHA256, MD5

// Defender XDR: DeviceProcessEvents for files read whole in the directory
let dirsift_sha256 = dynamic(["9f2c1b7d3e4a5f60718293a4b5c6d7e8f90a1b2c3d4e5f60718293a4b5c6d7e8"]);
let dirsift_md5 = dynamic(["0a1b2c3d4e5f60718293a4b5c6d7e8f9"]);
DeviceProcessEvents
| where Timestamp > ago(30d)
| where SHA256 in~ (dirsift_sha256) or MD5 in~ (dirsift_md5)
| project Timestamp, DeviceName, FolderPath, FileName, ProcessCommandLine, SHA256, MD5

// Defender XDR: mail that carried hosts or URLs found in the directory
let dirsift_domain = dynamic(["c2.evil-update.top", "cdn.panel-gate.xyz", "panel-gate.xyz"]);
let dirsift_url = dynamic(["c2.evil-update.top/gate.php?id=1&k=*", "panel-gate.xyz/files/", "raw.githubusercontent.com/someone/tools/main/x.ps1"]);
EmailUrlInfo
| where Timestamp > ago(30d)
| where UrlDomain in~ (dirsift_domain) or Url has_any (dirsift_url)
| project Timestamp, NetworkMessageId, Url, UrlDomain

// Sentinel: firewall and proxy events (CommonSecurityLog)
let dirsift_ip = dynamic(["198.51.100.23", "203.0.113.9", "2001:db8::7"]);
let dirsift_domain = dynamic(["c2.evil-update.top", "cdn.panel-gate.xyz", "panel-gate.xyz"]);
let dirsift_url = dynamic(["c2.evil-update.top/gate.php?id=1&k=*", "panel-gate.xyz/files/", "raw.githubusercontent.com/someone/tools/main/x.ps1"]);
CommonSecurityLog
| where TimeGenerated > ago(30d)
| where DestinationIP in (dirsift_ip) or DestinationHostName has_any (dirsift_domain) or RequestURL has_any (dirsift_domain) or RequestURL has_any (dirsift_url)
| project TimeGenerated, DeviceVendor, DeviceProduct, SourceIP, DestinationIP, DestinationHostName, RequestURL, DeviceAction

// Sentinel: DNS queries for domains found in the directory (DnsEvents)
let dirsift_domain = dynamic(["c2.evil-update.top", "cdn.panel-gate.xyz", "panel-gate.xyz"]);
DnsEvents
| where TimeGenerated > ago(30d)
| where Name has_any (dirsift_domain)
| project TimeGenerated, Computer, ClientIP, Name, IPAddresses
