// dirsift YARA-L 2.0 rules (Google SecOps)
// dirsift run golden-run | author cyb3rp03t | TLP:AMBER
// target hxxp://panel-gate[.]xyz/files/ | scan started 2026-10-01T09:00:00.000Z
// Found in an open directory, not a verdict: hunt with it, decide yourself.
// assumes UDM events (target.ip, network.dns.questions.name, target.hostname, target.url, target.file and target.process.file hashes)
// live values, not defanged: import it, do not open it in a browser or paste it in a chat.

rule dirsift_golden_run_network {
  meta:
    author = "cyb3rp03t"
    description = "Addresses found in an open directory. dirsift run golden-run. Found in an open directory, not a verdict: hunt with it, decide yourself."
    tlp = "TLP:AMBER"
    severity = "MEDIUM"
  events:
    ($e.target.ip = "198.51.100.23" or $e.target.ip = "203.0.113.9" or $e.target.ip = "2001:db8::7")
  condition:
    $e
}

rule dirsift_golden_run_dns {
  meta:
    author = "cyb3rp03t"
    description = "Domains found in an open directory, and their subdomains. dirsift run golden-run. Found in an open directory, not a verdict: hunt with it, decide yourself."
    tlp = "TLP:AMBER"
    severity = "MEDIUM"
  events:
    $e.metadata.event_type = "NETWORK_DNS"
    ($e.network.dns.questions.name = /(^|\.)c2\.evil-update\.top$/ nocase or $e.network.dns.questions.name = /(^|\.)cdn\.panel-gate\.xyz$/ nocase or $e.network.dns.questions.name = /(^|\.)panel-gate\.xyz$/ nocase)
  condition:
    $e
}

rule dirsift_golden_run_web {
  meta:
    author = "cyb3rp03t"
    description = "Hosts and URLs found in an open directory. dirsift run golden-run. Found in an open directory, not a verdict: hunt with it, decide yourself."
    tlp = "TLP:AMBER"
    severity = "MEDIUM"
  events:
    ($e.target.hostname = /(^|\.)c2\.evil-update\.top$/ nocase or $e.target.hostname = /(^|\.)cdn\.panel-gate\.xyz$/ nocase or $e.target.hostname = /(^|\.)panel-gate\.xyz$/ nocase or strings.contains($e.target.url, "c2.evil-update.top/gate.php?id=1&k=*") or strings.contains($e.target.url, "panel-gate.xyz/files/") or strings.contains($e.target.url, "raw.githubusercontent.com/someone/tools/main/x.ps1"))
  condition:
    $e
}

rule dirsift_golden_run_hashes {
  meta:
    author = "cyb3rp03t"
    description = "Files read whole in an open directory. dirsift run golden-run. Found in an open directory, not a verdict: hunt with it, decide yourself."
    tlp = "TLP:AMBER"
    severity = "MEDIUM"
  events:
    ($e.target.file.sha256 = "9f2c1b7d3e4a5f60718293a4b5c6d7e8f90a1b2c3d4e5f60718293a4b5c6d7e8" nocase or $e.target.process.file.sha256 = "9f2c1b7d3e4a5f60718293a4b5c6d7e8f90a1b2c3d4e5f60718293a4b5c6d7e8" nocase or $e.target.file.md5 = "0a1b2c3d4e5f60718293a4b5c6d7e8f9" nocase or $e.target.process.file.md5 = "0a1b2c3d4e5f60718293a4b5c6d7e8f9" nocase)
  condition:
    $e
}
