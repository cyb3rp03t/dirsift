// dirsift Elastic ES|QL hunting queries
// dirsift run golden-run | author cyb3rp03t | TLP:AMBER
// target hxxp://panel-gate[.]xyz/files/ | scan started 2026-10-01T09:00:00.000Z
// Found in an open directory, not a verdict: hunt with it, decide yourself.
// assumes ECS fields in a logs-* index pattern (destination.ip, dns.question.name, url.domain, url.full, file.hash.*, process.hash.*); change FROM to your own pattern
// assumes a 30 day window; each block runs alone, so a field your data lacks fails only its block
// live values, not defanged: import it, do not open it in a browser or paste it in a chat.

// connections to addresses found in the directory
FROM logs-*
| WHERE @timestamp > NOW() - 30 days
| WHERE destination.ip IN (TO_IP("198.51.100.23"), TO_IP("203.0.113.9"), TO_IP("2001:db8::7"))
| SORT @timestamp DESC
| LIMIT 1000

// DNS lookups of domains found in the directory, and their subdomains
FROM logs-*
| WHERE @timestamp > NOW() - 30 days
| WHERE dns.question.name IN ("c2.evil-update.top", "cdn.panel-gate.xyz", "panel-gate.xyz") OR ENDS_WITH(dns.question.name, ".c2.evil-update.top") OR ENDS_WITH(dns.question.name, ".cdn.panel-gate.xyz") OR ENDS_WITH(dns.question.name, ".panel-gate.xyz")
| SORT @timestamp DESC
| LIMIT 1000

// web requests to hosts found in the directory, and their subdomains
FROM logs-*
| WHERE @timestamp > NOW() - 30 days
| WHERE url.domain IN ("c2.evil-update.top", "cdn.panel-gate.xyz", "panel-gate.xyz") OR ENDS_WITH(url.domain, ".c2.evil-update.top") OR ENDS_WITH(url.domain, ".cdn.panel-gate.xyz") OR ENDS_WITH(url.domain, ".panel-gate.xyz")
| SORT @timestamp DESC
| LIMIT 1000

// web requests to URLs found in the directory, matched whole
FROM logs-*
| WHERE @timestamp > NOW() - 30 days
| WHERE url.full IN ("http://c2.evil-update.top/gate.php?id=1&k=*", "http://panel-gate.xyz/files/", "https://raw.githubusercontent.com/someone/tools/main/x.ps1")
| SORT @timestamp DESC
| LIMIT 1000

// files read whole in the directory, by sha256
FROM logs-*
| WHERE @timestamp > NOW() - 30 days
| WHERE file.hash.sha256 IN ("9f2c1b7d3e4a5f60718293a4b5c6d7e8f90a1b2c3d4e5f60718293a4b5c6d7e8")
| SORT @timestamp DESC
| LIMIT 1000

// processes started from those files, by sha256
FROM logs-*
| WHERE @timestamp > NOW() - 30 days
| WHERE process.hash.sha256 IN ("9f2c1b7d3e4a5f60718293a4b5c6d7e8f90a1b2c3d4e5f60718293a4b5c6d7e8")
| SORT @timestamp DESC
| LIMIT 1000

// files read whole in the directory, by md5
FROM logs-*
| WHERE @timestamp > NOW() - 30 days
| WHERE file.hash.md5 IN ("0a1b2c3d4e5f60718293a4b5c6d7e8f9")
| SORT @timestamp DESC
| LIMIT 1000

// processes started from those files, by md5
FROM logs-*
| WHERE @timestamp > NOW() - 30 days
| WHERE process.hash.md5 IN ("0a1b2c3d4e5f60718293a4b5c6d7e8f9")
| SORT @timestamp DESC
| LIMIT 1000
