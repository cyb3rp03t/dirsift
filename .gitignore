# --- samples and loot: never committed -------------------------------------
# DirSift is pointed at hostile infrastructure. Nothing that comes back from a
# scan target belongs in git. Hashes and YARA rules only.
*.exe
*.dll
*.bin
*.sample
*.scr
*.msi
*.jar
*.vbs
*.ps1.download
samples/
loot/
runs/
captures/
*.pcap

# --- scan outputs the README examples write to the working folder ----------
# They carry live addresses from a target, so they stay out of git and out
# of a package built from a working copy.
/run.json
/run*.json
/triage.md
/report.pdf
/report.md
/changes.md
/pivots.md
/hunt.yar
/rules/
/hunts/
/hunts.zip
/lists/
/out/
/*.stix.json

# --- secrets ---------------------------------------------------------------
.env
.env.*
!.env.example
*.key
*.pem

# --- python ----------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
dist/
build/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# --- data ------------------------------------------------------------------
*.sqlite
*.sqlite-wal
*.sqlite-shm
*.db

